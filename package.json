{
  "name": "subaru-dl",
  "productName": "Subaru DL",
  "version": "0.5.2",
  "description": "Interface gráfica para o yt-dlp",
  "author": "Ailton",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "binarios": "node scripts/baixar-binarios.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "instalador": "npm run binarios && electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
